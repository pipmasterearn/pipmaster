{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build PIPMASTER preview",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"npm install && npm run build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start PIPMASTER preview",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": "."
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "Local:.*5173"
				}
			}
		}
	]
}